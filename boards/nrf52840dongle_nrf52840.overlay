/ {
	zephyr,user {
		vbat-divider-ratio = <5>;
		io-channels = <&adc 0>;
		io-channel-names = "vbat";
	};

	aliases {
		/* this LED is super dim so no need to dim it */
		central1-status-led = &green_pwm_led;
		power-led = &red_pwm_led;
		data-activity-led = &blue_pwm_led;
	};

	leds {
		compatible = "gpio-leds";

		selfreset: selfreset-pin {
			gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;
			label = "Self Reset";
		};
	};
};


&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 20)>;
		zephyr,input-positive = <NRF_SAADC_VDDHDIV5>;
		zephyr,resolution = <14>;
		zephyr,oversampling = <2>;
	};
};

&spi0 {
	status = "disabled";
};

&spi1 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};
